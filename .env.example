DISCORD_TOKEN=
# Optional: comma-separated Discord user IDs. Defaults to application owner.
BOT_OWNER_IDS=
# Optional: use guild commands immediately, instead of global command propagation.
DISCORD_GUILD_ID=
NEKTO_AUTH_TOKEN=
DATA_DIR=./data
PORT=3000
# Optional browser overrides. Desktop defaults to visible installed Chrome.
# Railway defaults to headless bundled Chromium.
# NEKTO_BROWSER_CHANNEL=chrome
# NEKTO_HEADLESS=0
# Optional temporary protocol trace (native WebCrypto is unchanged by default).
# NEKTO_PROTOCOL_DIAGNOSTICS=1
